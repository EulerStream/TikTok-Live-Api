{
  "name": "tiktok-api-sdk",
  "version": "0.0.0",
  "description": "TikTok API SDK for Node.js & TypeScript. Typed client for the EulerStream TikTok API: user profiles, videos, OAuth, request signing and captcha solving, plus the full TikTok LIVE API for real-time chat, gifts, rooms, rankings, alerts and moderation.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "generate": "tsx ../common/scripts/generate.ts",
    "build": "tsdown",
    "test": "tsx ./test/basic.test.ts && tsx ./test/surface.test.ts && tsx ./test/aliases.test.ts && tsc --noEmit -p tsconfig.test.json",
    "test:e2e": "tsx ./test/e2e.test.ts",
    "format": "prettier --write src/**/*.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EulerStream/TikTok-Live-Api.git",
    "directory": "sdk/typescript/api"
  },
  "bugs": {
    "url": "https://github.com/EulerStream/TikTok-Live-Api/issues"
  },
  "keywords": [
    "tiktok",
    "tiktok api",
    "tiktok-api",
    "tiktokapi",
    "tiktok sdk",
    "tiktok api sdk",
    "tiktok api client",
    "tiktok user api",
    "tiktok video api",
    "tiktok oauth",
    "tiktok signing",
    "tiktok captcha",
    "tiktok captcha solver",
    "tiktok scraper",
    "tiktok data",
    "unofficial tiktok api",
    "tiktok live",
    "tiktok live api",
    "eulerstream",
    "euler stream",
    "api",
    "sdk",
    "client",
    "typescript",
    "nodejs"
  ],
  "author": "EulerStream (https://www.eulerstream.com)",
  "license": "MIT",
  "homepage": "https://www.eulerstream.com",
  "dependencies": {
    "axios": "^1.9.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.17.0",
    "@babel/core": "^7.17.2",
    "@babel/preset-env": "^7.16.11",
    "@types/node": "^22.15.3",
    "dotenv": "^16.5.0",
    "prettier": "2.5.1",
    "readline": "^1.3.0",
    "tsdown": "^0.21.10",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
