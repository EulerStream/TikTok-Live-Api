{
  "name": "tiktok-live-api-sdk",
  "version": "0.6.1",
  "description": "TikTok LIVE API SDK for Node.js & TypeScript. Real-time TikTok LIVE chat, gifts, likes, follows, viewer counts and PK battles via the EulerStream managed TikTok LIVE API, with typed clients for webcast signing, rooms, gifts, rankings, LIVE alerts, moderation, captchas and analytics.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "generate": "mkdir -p build && cp ../../spec/openapi.json ./build/openapi.json && python3 ../../.github/scripts/normalize_spec.py ./build/openapi.json && rm -rf ./src/sdk && npx @openapitools/openapi-generator-cli generate -i ./build/openapi.json -g typescript-axios -o ./src/sdk && tsx ./scripts/render-template.ts",
    "build": "tsdown",
    "test": "tsx ./test/basic.test.ts",
    "format": "prettier --write src/**/*.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EulerStream/TikTok-Live-Api.git",
    "directory": "sdk/typescript"
  },
  "bugs": {
    "url": "https://github.com/EulerStream/TikTok-Live-Api/issues"
  },
  "keywords": [
    "tiktok",
    "tiktok live",
    "tiktok-live",
    "tiktoklive",
    "tiktok live api",
    "tiktok api",
    "tiktok live sdk",
    "tiktok live chat",
    "tiktok live gifts",
    "tiktok gifts",
    "tiktok live stream",
    "tiktok livestream",
    "tiktok webcast",
    "tiktok live connector",
    "tiktok live events",
    "tiktok live alerts",
    "tiktok live moderation",
    "tiktok signing",
    "eulerstream",
    "euler stream",
    "live",
    "livestream",
    "stream",
    "chat",
    "gifts",
    "websocket",
    "webcast",
    "api",
    "sdk",
    "client",
    "bot",
    "scraper",
    "typescript",
    "nodejs"
  ],
  "author": "EulerStream (https://www.eulerstream.com)",
  "license": "MIT",
  "homepage": "https://www.eulerstream.com",
  "dependencies": {
    "axios": "^1.9.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.17.0",
    "@babel/core": "^7.17.2",
    "@babel/preset-env": "^7.16.11",
    "@types/node": "^22.15.3",
    "dotenv": "^16.5.0",
    "prettier": "2.5.1",
    "readline": "^1.3.0",
    "tsdown": "^0.21.10",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
