<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>EulerApiSdk</AssemblyName>
    <PackageId>EulerApiSdk</PackageId>
    <OutputType>Library</OutputType>
    <Authors>EulerStream</Authors>
    <Company>EulerStream</Company>
    <AssemblyTitle>TikTok LIVE API SDK for .NET</AssemblyTitle>
    <Title>TikTok LIVE API SDK for C# / .NET</Title>
    <Description>TikTok LIVE API SDK for C# / .NET. Real-time TikTok LIVE chat, gifts, likes, follows, viewer counts and PK battles via the EulerStream managed TikTok LIVE API, with typed async clients for webcast signing, rooms, gifts, rankings, LIVE alerts, moderation, captchas and analytics. Free tier available at https://www.eulerstream.com</Description>
    <Copyright>Copyright (c) EulerStream</Copyright>
    <RootNamespace>EulerApiSdk</RootNamespace>
    <Version>1.3.0</Version>
    <DocumentationFile>bin\$(Configuration)\$(TargetFramework)\EulerApiSdk.xml</DocumentationFile>
    <RepositoryUrl>https://github.com/EulerStream/TikTok-Live-Api.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://www.eulerstream.com</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>https://github.com/EulerStream/TikTok-Live-Api/commits/master</PackageReleaseNotes>
    <PackageTags>tiktok;tiktok-live;tiktoklive;tiktok-api;tiktok-live-api;tiktok-live-sdk;livestream;live-stream;webcast;websocket;chat;gifts;eulerstream;euler-stream;api;sdk;client;dotnet;csharp</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Nullable>enable</Nullable>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <!-- Include all source files explicitly, excluding generated test stubs -->
  <ItemGroup>
    <Compile Include="**\*.cs" Exclude="generated\src\EulerApiSdk.Test\**\*.cs" />
  </ItemGroup>

  <!-- README and icon rendered on the NuGet package page -->
  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http.Polly" Version="8.0.8" />
    <PackageReference Include="Microsoft.Net.Http.Headers" Version="8.0.8" />
  </ItemGroup>

</Project>
