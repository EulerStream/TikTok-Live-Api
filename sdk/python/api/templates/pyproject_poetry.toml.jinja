{# Custom override of openapi-python-client's pyproject_poetry.toml.jinja.
   The stock template emits placeholder metadata (no authors, keywords, URLs or
   classifiers) and a description derived from the OpenAPI title, none of which
   is what PyPI should show. Everything PyPI renders in the sidebar and search
   results is set here; project_name / package_name / package_version still
   come from the generator (config.yaml + `poetry version` in CI). #}
[tool.poetry]
name = "{{ project_name }}"
version = "{{ package_version | in_double_quote_literal }}"
description = "TikTok API SDK for Python. Typed sync and async client for the EulerStream TikTok API: user profiles, videos, OAuth, request signing and captcha solving, plus the full TikTok LIVE API for real-time chat, gifts, rooms, rankings, alerts and moderation."
authors = ["EulerStream"]
license = "MIT"
readme = "README.md"
homepage = "https://www.eulerstream.com"
repository = "https://github.com/EulerStream/TikTok-Api-Sdk"
documentation = "https://www.eulerstream.com/docs/intro"
keywords = [
    "tiktok",
    "tiktok api",
    "tiktok-api",
    "tiktokapi",
    "tiktok sdk",
    "tiktok api sdk",
    "tiktok api client",
    "tiktok user api",
    "tiktok video api",
    "tiktok oauth",
    "tiktok signing",
    "tiktok captcha",
    "tiktok captcha solver",
    "tiktok scraper",
    "tiktok data",
    "unofficial tiktok api",
    "tiktok live",
    "tiktok live api",
    "eulerstream",
    "euler stream",
    "api",
    "sdk",
    "client",
    "python",
]
classifiers = [
    "Development Status :: 4 - Beta",
    "Intended Audience :: Developers",
    "License :: OSI Approved :: MIT License",
    "Operating System :: OS Independent",
    "Programming Language :: Python :: 3",
    "Programming Language :: Python :: 3.11",
    "Programming Language :: Python :: 3.12",
    "Programming Language :: Python :: 3.13",
    "Topic :: Communications :: Chat",
    "Topic :: Internet :: WWW/HTTP",
    "Topic :: Multimedia :: Video",
    "Topic :: Software Development :: Libraries :: Python Modules",
    "Typing :: Typed",
]
packages = [
    { include = "{{ package_name }}" },
]
# The generated sources are git-ignored in the repository, and Poetry leaves
# VCS-ignored files out of a build unless they are included explicitly. Without
# these entries a build inside a git checkout ships metadata and no code.
# common/scripts/check_dist.py verifies what was built.
include = [
    { path = "{{ package_name }}/**/*.py", format = ["sdist", "wheel"] },
    { path = "{{ package_name }}/py.typed", format = ["sdist", "wheel"] },
]

[tool.poetry.urls]
"Homepage" = "https://www.eulerstream.com"
"Documentation" = "https://www.eulerstream.com/docs/intro"
"OpenAPI Reference" = "https://www.eulerstream.com/docs/openapi"
"Pricing" = "https://www.eulerstream.com/pricing"
"Discord" = "https://www.eulerstream.com/discord"
"Repository" = "https://github.com/EulerStream/TikTok-Api-Sdk"
"Issues" = "https://github.com/EulerStream/TikTok-Api-Sdk/issues"

[tool.poetry.dependencies]
python = "^3.11"
httpx = ">=0.23.1,<0.29.0"
attrs = ">=22.2.0"
python-dateutil = "^2.8.0"

[build-system]
requires = ["poetry-core>=2.0.0,<3.0.0"]
build-backend = "poetry.core.masonry.api"
